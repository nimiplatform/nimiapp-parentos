{
  "compilerOptions": {
    "paths": {
      "@renderer/*": ["./src/shell/renderer/*"],
      "@engine/*": ["./src/shell/renderer/engine/*"],
      "@nimiplatform/sdk": ["../../nimi-realm/nimi/sdks/typescript/index.ts"],
      "@nimiplatform/sdk/ai": ["../../nimi-realm/nimi/sdks/typescript/core/ai/index.ts"],
      "@nimiplatform/sdk/contracts": ["../../nimi-realm/nimi/sdks/typescript/core/contracts/index.ts"],
      "@nimiplatform/sdk/runtime": ["../../nimi-realm/nimi/sdks/typescript/runtime/index.ts"],
      "@nimiplatform/sdk/runtime/generated": ["../../nimi-realm/nimi/sdks/typescript/runtime/generated.ts"],
      "@nimiplatform/sdk/types": ["../../nimi-realm/nimi/sdks/typescript/types/index.ts"],
      "@nimiplatform/kit/auth": ["../../nimi-realm/nimi/kit/auth/src/index.ts"],
      "@nimiplatform/kit/core/model-config": ["../../nimi-realm/nimi/kit/core/src/model-config/index.ts"],
      "@nimiplatform/kit/core/oauth": ["../../nimi-realm/nimi/kit/core/src/oauth/index.ts"],
      "@nimiplatform/kit/core/runtime-capabilities": ["../../nimi-realm/nimi/kit/core/src/runtime-capabilities/index.ts"],
      "@nimiplatform/kit/core/sdk-contract": ["../../nimi-realm/nimi/kit/core/src/sdk-contract.ts"],
      "@nimiplatform/kit/features/model-config": ["../../nimi-realm/nimi/kit/features/model-config/src/index.ts"],
      "@nimiplatform/kit/features/model-picker": ["../../nimi-realm/nimi/kit/features/model-picker/src/index.ts"],
      "@nimiplatform/kit/features/model-picker/runtime": ["../../nimi-realm/nimi/kit/features/model-picker/src/runtime.ts"],
      "@nimiplatform/kit/features/model-picker/ui": ["../../nimi-realm/nimi/kit/features/model-picker/src/ui.ts"],
      "@nimiplatform/kit/shell/renderer/bridge": ["../../nimi-realm/nimi/kit/shell/renderer/src/bridge/index.ts"],
      "@nimiplatform/kit/ui": ["../../nimi-realm/nimi/kit/ui/src/index.ts"],
      "@nimiplatform/kit/ui/*": ["../../nimi-realm/nimi/kit/ui/src/*"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/client": ["./node_modules/@types/react-dom/client.d.ts"],
      "react-dom/server": ["./node_modules/@types/react-dom/server.d.ts"],
      "@tauri-apps/api/core": ["./node_modules/@tauri-apps/api/core.d.ts"],
      "@tauri-apps/api/*": ["./node_modules/@tauri-apps/api/*"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client", "react", "react-dom"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ]
}
