{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "assetId",
    "schemaVersion",
    "contentVersion",
    "schema",
    "authorityClass",
    "ownerContract",
    "review",
    "primarySection",
    "sections"
  ],
  "properties": {
    "assetId": {
      "const": "advisor-classifier"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "schema.json"
    },
    "authorityClass": {
      "enum": [
        "reference_dataset",
        "curated_knowledge_asset",
        "design_asset"
      ]
    },
    "ownerContract": {
      "type": "string",
      "minLength": 1
    },
    "generatedModule": {
      "type": "string",
      "minLength": 1
    },
    "runtimeProjectionAdmission": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "owner",
        "reviewer",
        "lastReviewedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "reviewed",
            "needs_review",
            "rejected"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastReviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false
    },
    "primarySection": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "x-parentos-sectionSchemas": {
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "domain",
          "definition",
          "examples",
          "recordGroups"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "definition": {
            "type": "object",
            "required": [
              "zh",
              "en"
            ],
            "properties": {
              "zh": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "examples": {
            "type": "object",
            "required": [
              "zh",
              "en"
            ],
            "properties": {
              "zh": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "en": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "recordGroups": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task",
          "definition",
          "examples"
        ],
        "properties": {
          "task": {
            "enum": [
              "chat",
              "knowledge",
              "records",
              "overview",
              "follow-up",
              "clarify"
            ]
          },
          "definition": {
            "type": "object",
            "required": [
              "zh",
              "en"
            ],
            "properties": {
              "zh": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "input",
                "output"
              ],
              "properties": {
                "context": {
                  "type": "object",
                  "required": [
                    "zh",
                    "en"
                  ],
                  "properties": {
                    "zh": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "input": {
                  "type": "object",
                  "required": [
                    "zh",
                    "en"
                  ],
                  "properties": {
                    "zh": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "output": {
                  "type": "object",
                  "required": [
                    "task",
                    "domains",
                    "groups",
                    "time",
                    "compare",
                    "detail"
                  ],
                  "properties": {
                    "task": {
                      "enum": [
                        "chat",
                        "knowledge",
                        "records",
                        "overview",
                        "follow-up",
                        "clarify"
                      ]
                    },
                    "domains": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      }
                    },
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      }
                    },
                    "time": {
                      "type": "object",
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string",
                          "minLength": 1
                        },
                        "days": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3660
                        }
                      }
                    },
                    "compare": {
                      "type": "boolean"
                    },
                    "detail": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "recordGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "groupId",
          "definition"
        ],
        "properties": {
          "groupId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "definition": {
            "type": "object",
            "required": [
              "zh",
              "en"
            ],
            "properties": {
              "zh": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
